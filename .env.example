# Classic GitHub token with no scopes (public read only). Empty: API tiles read "no token".
GITHUB_TOKEN=
# GitHub org to read. Empty uses quirq-ai.
MONITORING_ORG=
# The GitHub login "waiting on you" is about. Empty uses sharmasuraj0123.
MONITORING_OWNER=
# Set by `pnpm editor` only, never on Vercel: "gh" lets /settings open pull requests through your gh
# login, and the key is that run's (it is in the link pnpm editor prints). Leave both empty.
MONITORING_EDITOR=
MONITORING_EDITOR_KEY=
# Tests only: where tests/fake-gh/gh logs the writes it was asked for.
FAKE_GH_LOG=
# Tests only: where raw files and the API are read from (the fixture server). Empty uses GitHub.
MONITORING_RAW_BASE=
MONITORING_API_BASE=
# Tests only: Playwright's Chromium for local runs (cloud sessions: /opt/pw-browsers/chromium). Export it in the
# shell; Playwright does not read .env files. Empty uses Playwright's own installed Chromium.
PW_CHROMIUM_PATH=
